{
  "dynamic_specific": {
    "track_qa_config": {
      "models": {
        "example_quality_model": {
          "type": "onnx",
          "file": "models/example_quality_model.onnx",
          "features": [
            "snr",
            "residual"
          ],
          "input_name": "features",
          "output_name": "probabilities",
          "positive_class_index": 1
        }
      },
      "default_ml_paths": [
        {
          "name": "default_ml_quality_path",
          "model": "example_quality_model",
          "threshold": 0.55
        }
      ],
      "paths": [
        {
          "name": "quality_path",
          "ranges": {
            "snr": {
              "min": 20.0
            },
            "residual": {
              "max": 2.0
            }
          }
        },
        {
          "name": "limb_path",
          "ranges": {
            "snr": {
              "min": 12.0
            },
            "earth_limb_score": {
              "min": 0.75
            }
          }
        }
      ]
    }
  }
}
